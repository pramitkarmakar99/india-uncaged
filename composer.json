{
  "name": "india-uncaged/website",
  "type": "project",
  "description": "India Uncaged wildlife travel website.",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/socialite": "^5.23"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.24",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}